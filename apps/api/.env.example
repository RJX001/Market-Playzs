# Marketplays API — local env template (copy to .env)
# Never commit real secrets. Preview vs production: see docs/deployment.md
# Production Stripe/Supabase only on Vercel Production — never Preview.

DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT — access 15min (JWT_SECRET), refresh 7d HttpOnly cookie (JWT_REFRESH_SECRET)
JWT_SECRET=
JWT_REFRESH_SECRET=

# development | preview | production — controls Secure flag on refresh cookie
ENVIRONMENT=development

# Comma-separated extra CORS origins (localhost:3000 + production domains already allowed)
CORS_ORIGINS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
SENDGRID_API_KEY=
MAPBOX_SECRET_TOKEN=

# Vercel Cron: Authorization Bearer <CRON_SECRET>
CRON_SECRET=
